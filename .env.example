# Copy to .env (gitignored, chmod 600). These are the human-only brakes.
AGENT_ENABLED=0          # arm switch — 1 to allow side-effects
DRY_RUN=1                # 1 = log intended actions, never execute
DAILY_COST_CAP=5.0       # halt for the UTC day at this $ of spend
MAX_ACTIONS_PER_RUN=10   # max side-effects per cycle
POLL_SECONDS=60

# Add your own keys below (kept out of git):
# ANTHROPIC_API_KEY=
